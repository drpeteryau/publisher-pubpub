# Environment variables to set in Coolify (Resource -> Environment Variables)
# for compose.yaml. Lines marked REQUIRED make `docker compose` fail if empty.

# --- REQUIRED: infrastructure ---
# Host loopback port the app is published on; must be unique per app on the host.
# Used: 9203 (gentle-truths), 9204 (night-shift). Next free: 9205.
# Cloudflare Tunnel public hostname -> http://127.0.0.1:<PORT>. Leave Coolify Domains empty.
PORT=9205
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# POSTGRES_USER=pubpub
# POSTGRES_DB=pubpub
# RABBITMQ_USER=pubpub

# --- REQUIRED: app secrets (generate with: openssl rand -hex 32) ---
JWT_SIGNING_SECRET=
SESSION_SECRET=
AES_ENCRYPTION_KEY=
ALTCHA_HMAC_KEY=
# base64 of the Firebase service-account JSON (editor collaboration backend)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# S3 bucket credentials for uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SMTP (e.g. SES)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# SMTP_PORT=587

# --- Cloudflare Tunnel ---
# Default: cloudflared runs on the Docker host -> http://127.0.0.1:<PORT> (nothing to set here).
# Only if you want cloudflared inside this compose instead (service http://app:<PORT>):
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# Defaults already assume TLS ends at Cloudflare; only change if you serve plain HTTPS directly.
# DISABLE_SSL_REDIRECT=true
# TRUST_CF_VISITOR=true

# --- Optional ---
# Serve one community for every hostname (slug), useful for a single-site tunnel.
# PUBPUB_LOCAL_COMMUNITY=
# DOI_LOGIN_ID=
# DOI_LOGIN_PASSWORD=
# DOI_SUBMISSION_URL=
# ZOTERO_CLIENT_KEY=
# ZOTERO_CLIENT_SECRET=
# SLACK_WEBHOOK_URL=
# CLOUDFLARE_ANALYTICS_API_TOKEN=
# CLOUDFLARE_ZONE_TAG=
# CLOUDFLARE_CUSTOM_HOSTNAME_API_TOKEN=
